{
  "name": "dsh-computer-use",
  "version": "0.1.0",
  "description": "适用于 Windows 的 DeepSeek Harness Computer Use 插件（UIA + cua-driver + 可选 GLM 视觉）",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": ["dsh", "computer-use", "cua-driver", "harness-desktop", "autopilot"],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/*.js",
    "test": "node --test test/*.test.js",
    "verify:host": "node tools/verify-host-modules.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.0.0"
  }
}
